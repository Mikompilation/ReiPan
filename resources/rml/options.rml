<rml>
<head>
    <title>Options</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="options.rcss"/>
</head>
<body id="options">
    <!-- Light: from the pause the game's own menu backdrop -- its lattice,
         snow and fog -- is under the screen, and from the title the title. -->
    <div class="backdrop light"></div>
    <div id="frame">
        <div id="panel" class="window">
            <div class="window-bar top"></div>
            <div class="window-bar bottom"></div>
        </div>
        <div id="header" class="band">
            <h1 class="title">Options</h1>
        </div>
        <!-- Sections and their rows are built by reipan_rml_options.cpp. -->
        <div id="tabs"></div>
        <div class="rule" id="rule-top"></div>
        <div id="pages"></div>
        <div class="rule" id="rule-bottom"></div>
        <p id="help"></p>
        <div id="prompts" class="prompts"></div>
    </div>
    <div id="confirm" class="confirm hidden">
        <div class="confirm-box window">
            <div class="window-bar top"></div>
            <p class="confirm-text"></p>
            <p class="confirm-note"></p>
            <div class="confirm-choices">
                <span id="confirm-yes" class="confirm-choice selectable">Yes</span>
                <span id="confirm-no" class="confirm-choice selectable">No</span>
            </div>
            <div class="window-bar bottom"></div>
        </div>
    </div>
</body>
</rml>
