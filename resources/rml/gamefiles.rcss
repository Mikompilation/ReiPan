/*
 * The screen ReiPan opens on when it cannot find the game.  Nothing of the
 * game's is running or even readable here, so there is no room behind it and
 * no art of the game's to lean on: a hemp leaf glows out of the cold dark on
 * its own, over the same window, jade band and film grain as every other menu.
 */

#ground
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #070a0d;
}

/* A cold light behind the emblem, drifting slowly brighter and dimmer. */
#bloom
{
    position: absolute;
    left: 50%;
    top: -120dp;
    width: 640dp;
    height: 480dp;
    margin-left: -320dp;
    decorator: image(images/bloom.png);
    animation: 7s cubic-in-out infinite alternate moonlight;
}

@keyframes moonlight
{
    from { opacity: 0.55; }
    to   { opacity: 1; }
}

/* The same leaf, huge and barely there, across the whole picture. */
#ghost
{
    position: absolute;
    left: 50%;
    top: 24dp;
    width: 400dp;
    height: 400dp;
    margin-left: -200dp;
    decorator: image(images/emblem.png);
    opacity: 0.05;
}

#film
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    decorator: image(images/vignette.png), image(images/grain.png repeat);
}

#emblem
{
    display: block;
    position: absolute;
    left: 50%;
    top: 10dp;
    width: 54dp;
    height: 54dp;
    margin-left: -27dp;
    animation: 2.8s cubic-in-out infinite alternate breathe;
}

@keyframes breathe
{
    from { opacity: 0.72; transform: scale(0.97); }
    to   { opacity: 1;    transform: scale(1.02); }
}

#frame
{
    position: absolute;
    left: 50%;
    top: 72dp;
    width: 488dp;
    margin-left: -244dp;
    text-align: center;
    animation: 0.5s quadratic-out rise-in;
}

#frame .title
{
    font-size: 22dp;
    line-height: 30dp;
    white-space: nowrap;
}

#lead
{
    margin: 12dp 26dp 0 26dp;
    font-size: 14.5dp;
    line-height: 19dp;
    color: #e4e6dc;
}

/* Worth reading before going to look for a file: no other release will do. */
#release
{
    margin-top: 5dp;
    font-size: 13.5dp;
    line-height: 17dp;
    font-style: italic;
    color: #f1d69b;
}

/* ---- what to look for -------------------------------------------------- */

#kinds
{
    display: flex;
    justify-content: space-between;
    margin: 14dp 14dp 0 14dp;
}

.kind
{
    box-sizing: border-box;
    width: 224dp;
    padding: 8dp 12dp 9dp 12dp;
    border: 1dp #2a3d48;
    background-color: #0d151bd8;
    text-align: left;
}

.kind-name
{
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
    color: #9fc8b8;
}

.kind-file
{
    margin-top: 2dp;
    font-size: 15dp;
    color: #f6f2e2;
}

.kind-note
{
    margin-top: 3dp;
    font-size: 11.5dp;
    line-height: 14dp;
    font-style: italic;
    color: #8d9780;
}

/* ---- the two buttons --------------------------------------------------- */

#actions
{
    margin-top: 16dp;
    transition: opacity 0.25s linear-in-out;
}

.action
{
    display: inline-block;
    box-sizing: border-box;
    width: 220dp;
    height: 28dp;
    line-height: 26dp;
    border: 1dp #2a3d48;
    background-color: #13202a;
    font-size: 14dp;
    letter-spacing: 1.5dp;
    text-transform: uppercase;
    color: #8d9780;
    cursor: pointer;
    transition: color border-color 0.12s linear-in-out;
}

#quit
{
    width: 156dp;
    margin-left: 12dp;
}

.action.selected
{
    border-color: #d8ccb0;
    background-color: #2f4650;
    decorator: image(images/cursor_bar.png);
    color: #f6f2e2;
}

/* The system's file dialog is open: nothing here answers until it closes. */
#frame.choosing .action
{
    color: #4e5a58;
    cursor: default;
}

#frame.choosing .action.selected
{
    border-color: #2a3d48;
    background-color: #13202a;
    decorator: none;
}

/* ---- what came of it --------------------------------------------------- */

/* A fixed height, so a message appearing does not move anything above it. */
#status
{
    height: 62dp;
    margin-top: 12dp;
    padding: 0 18dp;
}

#status-text
{
    font-size: 13dp;
    line-height: 16dp;
    font-style: italic;
    color: #8d9780;
}

#status-file
{
    margin-top: 2dp;
    font-size: 11dp;
    line-height: 13dp;
    color: #8e989c;
    word-break: break-all;
}

#status.problem #status-text
{
    color: #f1d69b;
}

#status.found #status-text
{
    font-style: normal;
    color: #9ee0da;
    font-effect: glow(1dp 5dp 0dp 1dp #2f8a7099);
}

/* Found: the choice is made and the buttons step back. */
#frame.found #actions
{
    opacity: 0.25;
}

#prompts
{
    position: absolute;
    right: 20dp;
    bottom: 12dp;
}

/* Then the whole screen goes to the black the game starts from.  Over the top
 * of it rather than fading what is there: RmlUi inherits opacity instead of
 * multiplying it, so everything here with an opacity of its own, the animated
 * light and emblem among them, would ignore a parent's fade.  Not displayed
 * until then, or it would be what the mouse is over. */
#veil
{
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
}

#veil.closing
{
    display: block;
    animation: 0.4s linear-in-out fade-in;
}
